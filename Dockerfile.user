FROM node:20-alpine AS base
WORKDIR /app

# Copy root package files
COPY package.json package-lock.json ./

# Copy all package.json files for workspaces to install dependencies
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY server-user/package.json server-user/
COPY server-admin/package.json server-admin/

# Install dependencies (including devDependencies for building)
RUN npm ci --include=dev

FROM base AS builder
WORKDIR /app

# Copy source code
COPY tsconfig.base.json tsconfig.json ./
COPY packages/ packages/
COPY server-user/ server-user/

# Build shared packages and the user server
RUN npm run build --workspace=@kd/shared
RUN npm run build --workspace=@kd/db
RUN npm run build --workspace=@kd/server-user

FROM node:20-alpine AS production
WORKDIR /app
ENV NODE_ENV=production

# Copy built artifacts and node_modules from builder
COPY --from=builder /app/package.json ./
COPY --from=builder /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/server-user ./server-user

# Add a startup script to handle migrations before starting the server.
# NOTE: We call tsx directly (not via npm workspace scripts) because the
# npm scripts use --env-file=../../.env which doesn't exist in Docker.
# Docker injects env vars via the compose "environment:" block instead.
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'set -e' >> /app/start.sh && \
    echo 'cd /app/packages/db && npx tsx db/scripts/migrate.ts' >> /app/start.sh && \
    echo 'cd /app/packages/db && npx tsx db/scripts/create-mongo-indexes.ts' >> /app/start.sh && \
    echo 'cd /app && npm run start --workspace=@kd/server-user' >> /app/start.sh && \
    chmod +x /app/start.sh

EXPOSE 10000

CMD ["/app/start.sh"]
